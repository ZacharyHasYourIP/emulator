{
  "name": "Cloud Browser",
  "image": "://microsoft.com",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "version": "latest"
    }
  },
  "forwardPorts":,
  "portsAttributes": {
    "6080": {
      "label": "Browser Desktop",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y google-chrome-stable"
}
